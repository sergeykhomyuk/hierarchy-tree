# Nothing here is secret (invariants 20, 133) - every value is a public default,
# committed as documentation. No .env* file with real values is ever committed;
# scripts/assert-no-secrets.mjs enforces that.

# Absolute https URL. Default: https://gongfetest.firebaseio.com
VITE_API_BASE_URL=https://gongfetest.firebaseio.com

# One of debug | info | warn | error | silent. Default: debug in development, warn in production.
VITE_LOG_LEVEL=debug

# One of console | buffer | none. Default: console in development, buffer in production, none under test.
VITE_OBSERVABILITY_SINK=console

# Integer milliseconds, 1-60000. Default: 8000.
VITE_REQUEST_TIMEOUT_MILLISECONDS=8000

# Gates the e2e-readable telemetry buffer handle. Default: true.
VITE_FEATURE_TELEMETRY_BUFFER_HANDLE=true

# Gates the development-only /__kit route. Default: true in development, false in production.
VITE_DEVELOPMENT_ROUTES=true

# production-hostname: https://hierarchy-tree.pages.dev
